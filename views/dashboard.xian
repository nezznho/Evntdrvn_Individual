{{> head}}
<body>
<div class="app-shell">
  {{> sidebar}}
  <main id="main-content" tabindex="-1">
    <header><div><h1>Dashboard</h1><p>Here’s what’s happening with your inventory today.</p></div>{{#if isAdmin}}<button class="primary-btn" data-action="add-product" aria-keyshortcuts="n" onclick="openAddProduct()">＋ Add Product <kbd>N</kbd></button>{{/if}}</header>
    {{> flash}}
    <section id="overview" class="stats-grid" aria-label="Overview">
      <article class="stat"><div class="stat-icon blue" aria-hidden="true">▦</div><div><span>Total inventory value</span><strong>₱{{value}}</strong><small>Across {{total}} products · {{lotCount}} active lots</small></div></article>
      <article class="stat"><div class="stat-icon orange" aria-hidden="true">!</div><div><span>Low stock items</span><strong>{{lowCount}}</strong><small>25 units or fewer</small></div></article>
      <article class="stat"><div class="stat-icon pink" aria-hidden="true">◷</div><div><span>Lots expiring / expired</span><strong>{{expiringCount}}</strong><small>Within 45 days</small></div></article>
      <article class="stat"><div class="stat-icon green" aria-hidden="true">↗</div><div><span>Stock activity</span><strong>{{logs.length}}</strong><small>{{#if isAdmin}}Recent movements · {{voidCount}} void(s){{else}}See batch history{{/if}}</small></div></article>
    </section>

    <section class="alert-grid">
      <div class="panel"><div class="panel-title"><h2><span class="dot orange-dot"></span>Low Stock Alert</h2><a href="#inventory">View inventory →</a></div>
        {{#each low}}<div class="alert-row"><div><b>{{this.name}}</b><small>{{this.category}}</small></div><span>{{this.quantity}} left</span></div>{{else}}<p class="empty">All products are above the reorder level.</p>{{/each}}</div>
      <div class="panel"><div class="panel-title"><h2><span class="dot pink-dot"></span>Expiry Alerts (by lot)</h2><a href="#batches">View lots →</a></div>
        {{#each expiring}}<div class="alert-row"><div><b>{{this.productName}} <code class="lot">{{this.batchNumber}}</code></b><small>{{this.quantity}} units · expires {{this.expiryDate}}</small></div>{{#if this.isExpired}}<span class="badge badge-red">Expired – pull out</span>{{else}}<span class="expiry-badge">{{this.days}} days</span>{{/if}}</div>{{else}}<p class="empty">No lots expiring within 45 days.</p>{{/each}}</div>
    </section>

    <section id="inventory" class="panel inventory-panel" aria-labelledby="inventoryHeading"><div class="panel-title"><div><h2 id="inventoryHeading">Inventory</h2><p>Quantities are the sum of active lots. They change only through logged stock movements.</p></div></div>
      <div class="toolbar"><input id="search" type="search" data-search-input="products" aria-label="Search products" aria-keyshortcuts="/" placeholder="Search products…  /" oninput="filterInventory()"><select id="categoryFilter" data-filter="category" aria-label="Filter by category" aria-keyshortcuts="f" onchange="filterInventory()"><option value="">All categories</option><option>Antibiotics</option><option>Pain Relief</option><option>Antihistamines</option><option>Diabetes</option><option>Digestive Health</option><option>Supplements</option><option>Respiratory</option></select></div>
      <div class="table-wrap"><table><thead><tr><th>PRODUCT</th><th>CATEGORY</th><th>QUANTITY</th><th>LOTS</th><th>NEAREST EXPIRY</th><th>UNIT PRICE</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="productRows" data-table="products">
      {{#each inventory}}<tr data-row="product" data-id="{{this.id}}" data-name="{{this.name}}" data-category="{{this.category}}" data-price="{{this.price}}" data-barcode="{{this.barcode}}" data-sellable="{{this.sellable}}" data-lots="{{this.dispenseOptions}}">
        <td><div class="product"><span>{{this.name}}</span></div></td>
        <td><span class="category">{{this.category}}</span></td>
        <td><div class="quantity {{#if this.isLow}}low{{/if}}"><strong>{{this.quantity}}</strong><small>units</small></div></td>
        <td>{{this.lotCount}}</td>
        <td>{{#if this.expiry}}{{this.expiry}}{{else}}<small class="muted">No stock</small>{{/if}}</td>
        <td>₱{{this.price}}</td>
        <td><button class="row-menu" data-row-menu aria-label="Actions for {{this.name}}" aria-haspopup="menu" aria-expanded="false" onclick="toggleMenu(this)">⋮</button><div class="row-actions" role="menu" aria-label="Actions for {{this.name}}">
          <button role="menuitem" data-action="stock-in" onclick="openStockIn(this)">Receive stock (Stock In)</button>
          <button role="menuitem" data-action="dispense" onclick="openDispense(this)">Dispense</button>
          {{#if ../isAdmin}}<button role="menuitem" data-action="edit-product" onclick="openProductEdit(this)">Edit details</button><button role="menuitem" class="danger" data-action="archive-product" onclick="openArchive(this)">Delete (archive)</button>{{/if}}
        </div></td></tr>{{else}}<tr><td colspan="7" class="empty">No active products.</td></tr>{{/each}}
      </tbody></table></div>
    </section>

    <section id="batches" class="panel inventory-panel" aria-labelledby="batchesHeading"><div class="panel-title"><div><h2 id="batchesHeading">Batch / Lot Tracking</h2><p>Every unit belongs to a manufacturer lot. Open a lot for its full movement history, or to expire or recall it.</p></div></div>
      <div class="toolbar"><input id="lotSearch" type="search" data-search-input="lots" aria-label="Search lots" aria-keyshortcuts="/" placeholder="Search lot number or product…  /" oninput="filterLots()"></div>
      <div class="table-wrap"><table><thead><tr><th>LOT / BATCH NO.</th><th>PRODUCT</th><th>MANUFACTURER</th><th>ON HAND</th><th>EXPIRY</th><th>STATUS</th><th><span class="sr-only">History</span></th></tr></thead><tbody id="lotRows" data-table="lots">
      {{#each batches}}<tr data-row="lot" data-id="{{this.id}}" data-product-id="{{this.productId}}" data-search="{{this.batchNumber}} {{this.productName}}">
        <td><code class="lot">{{this.batchNumber}}</code></td><td>{{this.productName}}</td><td>{{#if this.manufacturer}}{{this.manufacturer}}{{else}}<small class="muted">—</small>{{/if}}</td>
        <td><strong>{{this.quantity}}</strong></td><td>{{this.expiryDate}}</td>
        <td>{{#if this.isExpired}}<span class="badge badge-red">Expired</span>{{else if this.isExpiringSoon}}<span class="badge badge-orange">{{this.days}} days left</span>{{else}}<span class="badge badge-green">Active</span>{{/if}}</td>
        <td><a class="link" data-row-open href="/batches/{{this.id}}">View history<span class="sr-only"> of lot {{this.batchNumber}}</span> →</a></td></tr>{{else}}<tr><td colspan="7" class="empty">No lots with stock on hand.</td></tr>{{/each}}
      </tbody></table></div>
    </section>

    {{#if isAdmin}}
    <section id="logs" class="panel inventory-panel" aria-labelledby="logsHeading"><div class="panel-title"><div><h2 id="logsHeading">Stock Activity Log</h2><p>Append-only audit trail. Entries cannot be edited or deleted. Mistakes are reversed with a <span class="badge badge-red">VOID</span> entry.</p></div>
      <div class="legend"><span class="badge badge-green">Stock in</span><span class="badge badge-purple">Dispensed</span><span class="badge badge-orange">Expired</span><span class="badge badge-amber">Recalled</span><span class="badge badge-red">VOID</span></div></div>
      <div class="table-wrap"><table class="log-table"><thead><tr><th>DATE / TIME</th><th>ACTION</th><th>PRODUCT</th><th>LOT</th><th>QTY</th><th>BALANCE</th><th>STAFF</th><th>REFERENCE / REASON</th><th><span class="sr-only">Void</span></th></tr></thead><tbody>
      {{#each logs}}<tr class="{{#if this.isVoid}}row-void{{/if}} {{#if this.isVoided}}row-voided{{/if}}">
        <td><small>{{this.time}}</small></td>
        <td><span class="badge {{this.badge}}">{{this.label}}</span>{{#if this.isVoided}} <span class="badge badge-outline-red" title="Reversed by log #{{this.voidLogId}}">VOIDED</span>{{/if}}</td>
        <td>{{this.product}}</td>
        <td>{{#if this.batchNumber}}<a href="/batches/{{this.batchId}}"><code class="lot">{{this.batchNumber}}</code></a>{{else}}<small class="muted">—</small>{{/if}}</td>
        <td class="{{this.qtyClass}}"><strong>{{this.amountText}}</strong></td>
        <td>{{this.balanceText}}</td>
        <td>{{this.user}}</td>
        <td class="ref-cell">{{#if this.reference}}<small class="muted">{{this.reference}}</small>{{/if}}{{#if this.isVoid}}<small class="void-of">↩ reverses log #{{this.voidOfId}}</small>{{/if}}{{#if this.reason}}<small class="reason">“{{this.reason}}”</small>{{/if}}</td>
        <td>{{#if this.canVoid}}<button class="void-btn" data-action="void" data-id="{{this.id}}" data-desc="{{this.label}}: {{this.amountText}} × {{this.product}} (lot {{this.batchNumber}}, {{this.reference}})" onclick="openVoid(this)">Void</button>{{/if}}</td>
      </tr>{{else}}<tr><td colspan="9" class="empty">No stock movements yet.</td></tr>{{/each}}
      </tbody></table></div>
    </section>

    <section id="staff" class="panel staff-panel" aria-labelledby="staffHeading"><div class="panel-title"><h2 id="staffHeading">Staff Accounts</h2><button class="small-btn" data-action="add-staff" onclick="openModal('staffModal')">＋ Add staff</button></div>
      {{#each users}}<div class="person"><div class="avatar small" aria-hidden="true">{{this.name}}</div><div><b>{{this.name}}</b><small>{{this.email}}</small></div><span class="role">{{this.role}}</span>{{#unless this.isSelf}}<form method="POST" action="/staff/{{this.id}}/delete" onsubmit="return confirm('Deactivate {{this.name}}? They will no longer be able to log in, but their history is kept and an admin can restore them.')"><button class="delete-icon" title="Deactivate (soft delete)" aria-label="Deactivate {{this.name}}">×</button></form>{{/unless}}</div>{{/each}}
    </section>
    {{/if}}
  </main>
</div>

<div id="productModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="productTitle"><form method="POST" action="/products"><button type="button" class="modal-close" aria-label="Close dialog" onclick="closeModal('productModal')">×</button><h2 id="productTitle">Add product</h2>
  <div class="form-grid">
    <label>Product name<input name="name" required></label>
    <label>Category<select name="category"><option>Antibiotics</option><option>Pain Relief</option><option>Antihistamines</option><option>Diabetes</option><option>Digestive Health</option><option>Supplements</option><option>Respiratory</option></select></label>
    <label>Unit price<input name="price" type="number" step="0.01" min="0" required></label>
    <label>Barcode<input name="barcode" maxlength="64" autocomplete="off" data-scan-accept placeholder="Scan or type (optional)"></label>
  </div>
  <fieldset class="opening-stock"><legend>Opening stock (optional)</legend><div class="form-grid">
    <label>Batch / Lot no.<input name="batchNumber" placeholder="e.g. AMX24051"></label>
    <label>Lot expiry date<input name="expiryDate" type="date"></label>
    <label>Quantity<input name="quantity" type="number" min="0" value="0"></label>
    <label>Manufacturer<input name="manufacturer" placeholder="e.g. Unilab"></label>
  </div></fieldset>
  <p class="hint edit-only">Quantity and expiry can’t be edited here. Use <b>Receive stock</b>, <b>Dispense</b>, or a lot’s expire/recall action so every change is logged.</p>
  <button class="primary-btn" type="submit">Save product</button></form></div>

<div id="stockModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="stockTitle"><form id="stockForm" method="POST"><button type="button" class="modal-close" aria-label="Close dialog" onclick="closeModal('stockModal')">×</button><h2 id="stockTitle">Receive stock</h2>
  <div class="form-grid">
    <label>Batch / Lot no.<input name="batchNumber" required placeholder="As printed on the box"></label>
    <label>Expiry date<input name="expiryDate" type="date" required></label>
    <label>Quantity received<input name="quantity" type="number" min="1" required></label>
    <label>Manufacturer<input name="manufacturer" placeholder="Optional"></label>
    <label class="span-2">Delivery receipt / Invoice no.<input name="reference" maxlength="40" placeholder="Optional, auto-generated if blank"></label>
  </div>
  <button class="primary-btn" type="submit">Record Stock In</button></form></div>

<div id="dispenseModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="dispenseTitle"><form id="dispenseForm" method="POST"><button type="button" class="modal-close" aria-label="Close dialog" onclick="closeModal('dispenseModal')">×</button><h2 id="dispenseTitle">Dispense product</h2>
  <p class="hint" id="dispenseAvail"></p>
  <div class="form-grid">
    <label>Quantity to dispense<input name="quantity" type="number" min="1" required></label>
    <label>From lot<select name="batchId" id="dispenseLot"></select></label>
  </div>
  <p class="hint">Tip: scan a product barcode to switch product, or a lot number to pick that lot.</p>
  <button class="primary-btn" type="submit">Record dispensing</button></form></div>

<div id="archiveModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="archiveTitle"><form id="archiveForm" method="POST"><button type="button" class="modal-close" aria-label="Close dialog" onclick="closeModal('archiveModal')">×</button><h2 id="archiveTitle">Archive product</h2>
  <p class="hint">This is a <b>soft delete</b>. The product is hidden from inventory, but it and all its lots and logs stay in the database. An admin can restore it from the Archive page.</p>
  <label>Reason (required)<textarea name="reason" minlength="5" required placeholder="e.g. Discontinued by supplier"></textarea></label>
  <button class="primary-btn danger-btn" type="submit">Archive product</button></form></div>

<div id="voidModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="voidTitle"><form id="voidForm" method="POST"><button type="button" class="modal-close" aria-label="Close dialog" onclick="closeModal('voidModal')">×</button><h2 id="voidTitle">Void transaction</h2>
  <p class="hint" id="voidDesc"></p>
  <p class="hint">Stock is restored to the original lot and a red <span class="badge badge-red">VOID</span> entry is added. The original entry is kept and marked VOIDED. All lines with the same reference are voided together.</p>
  <label>Reason for void (required)<textarea name="reason" minlength="5" required placeholder="e.g. Customer cancelled before payment"></textarea></label>
  <button class="primary-btn danger-btn" type="submit">Confirm void</button></form></div>

<div id="staffModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="staffTitle"><form method="POST" action="/staff"><button type="button" class="modal-close" aria-label="Close dialog" onclick="closeModal('staffModal')">×</button><h2 id="staffTitle">Add staff member</h2><div class="form-grid"><label>Name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Password<input name="password" value="staff123" required></label><label>Role<select name="role"><option value="staff">Staff</option><option value="admin">Admin</option></select></label></div><button class="primary-btn" type="submit">Add staff</button></form></div>
<script src="/js/pharma.js"></script>
{{> keyboard}}
{{> footer }}
