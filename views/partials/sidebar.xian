<a href="#main-content" class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-md focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">Skip to content</a>
<aside class="sidebar" data-user-role="{{user.role}}"><div class="side-brand"><div class="brand-mark" aria-hidden="true">✚</div><div><strong>Pharma</strong><small>INVENTORY</small></div></div>
  <nav aria-label="Main">
    <a class="{{#unless archiveActive}}active{{/unless}}" href="/dashboard#overview" data-nav="overview" aria-keyshortcuts="g o"><span aria-hidden="true">⌂</span>Overview</a>
    <a href="/dashboard#inventory" data-nav="inventory" aria-keyshortcuts="g i"><span aria-hidden="true">▦</span>Inventory</a>
    <a href="/dashboard#batches" data-nav="batches" aria-keyshortcuts="g b"><span aria-hidden="true">▤</span>Batches / Lots</a>
    {{#if isAdmin}}<a href="/dashboard#logs" data-nav="logs" aria-keyshortcuts="g l"><span aria-hidden="true">≡</span>Stock logs</a><a href="/dashboard#staff" data-nav="staff" aria-keyshortcuts="g s"><span aria-hidden="true">♙</span>Staff</a><a class="{{#if archiveActive}}active{{/if}}" href="/admin/archive" data-nav="archive" aria-keyshortcuts="g a"><span aria-hidden="true">🗄</span>Archive</a>{{/if}}
  </nav>
  <div class="user-card"><div class="avatar" aria-hidden="true">{{user.name}}</div><div><b>{{user.name}}</b><small>{{user.role}}</small></div><a href="/logout" title="Logout" aria-label="Log out" data-action="logout">↪</a></div>
</aside>
