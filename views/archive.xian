{{> head}}
<body>
<div class="app-shell">
  {{> sidebar archiveActive=true}}
  <main id="main-content" tabindex="-1">
    <header><div><h1>Archive</h1><p>Admin only. Soft-deleted records are kept permanently for legal and audit purposes. Nothing here can be permanently deleted.</p></div></header>
    {{> flash}}
    <section class="panel inventory-panel"><div class="panel-title"><div><h2>Archived products ({{productCount}})</h2><p>Hidden from inventory. Their lots and stock logs are kept.</p></div></div>
      <div class="table-wrap"><table><thead><tr><th>PRODUCT</th><th>CATEGORY</th><th>QTY AT ARCHIVE</th><th>ARCHIVED</th><th>BY</th><th>REASON</th><th></th></tr></thead><tbody>
      {{#each products}}<tr><td><b>{{this.name}}</b></td><td><span class="category">{{this.category}}</span></td><td>{{this.quantity}}</td><td><small>{{this.archivedAt}}</small></td><td>{{this.archivedBy}}</td><td><small class="reason">“{{this.deleteReason}}”</small></td>
        <td><form method="POST" action="/products/{{this.id}}/restore"><button class="small-btn">↺ Restore</button></form></td></tr>{{else}}<tr><td colspan="7" class="empty">No archived products.</td></tr>{{/each}}
      </tbody></table></div>
    </section>
    <section class="panel inventory-panel"><div class="panel-title"><div><h2>Deactivated staff ({{staffCount}})</h2><p>These accounts cannot log in. Their names stay on every log entry they created.</p></div></div>
      <div class="table-wrap"><table><thead><tr><th>NAME</th><th>EMAIL</th><th>ROLE</th><th>DEACTIVATED</th><th>BY</th><th></th></tr></thead><tbody>
      {{#each staff}}<tr><td><b>{{this.name}}</b></td><td>{{this.email}}</td><td><span class="role">{{this.role}}</span></td><td><small>{{this.archivedAt}}</small></td><td>{{this.archivedBy}}</td>
        <td><form method="POST" action="/staff/{{this.id}}/restore"><button class="small-btn">↺ Reactivate</button></form></td></tr>{{else}}<tr><td colspan="6" class="empty">No deactivated staff.</td></tr>{{/each}}
      </tbody></table></div>
    </section>
  </main>
</div>
<script src="/js/pharma.js"></script>
{{> keyboard}}
{{> footer }}
