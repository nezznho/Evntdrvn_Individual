{{> head}}
<body class="login-page"><main class="login-shell"><section class="login-brand"><div class="brand-mark">✚</div><div><b>Pharma</b><span>Inventory Management</span></div></section><section class="login-card"><div class="login-icon">✚</div><h1>Create account</h1><p>Join your pharmacy team</p>{{#if error}}<div class="alert error">{{error}}</div>{{/if}}<form method="POST" action="/register"><label>Full name<input name="name" required></label><label>Email address<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="primary-btn" type="submit">Create account</button></form><a class="login-create" href="/login">Already have an account? Sign in</a></section></main>{{> footer }}