{{> head}}
<body class="login-page">
  <main class="login-shell">
    <section class="login-brand"><div class="brand-mark">✚</div><div><b>Pharma</b><span>Inventory Management</span></div></section>
    <section class="login-card">
      <div class="login-icon">✚</div><h1>Welcome back</h1><p>Sign in to manage your pharmacy inventory</p>
      {{#if error}}<div class="alert error">{{error}}</div>{{/if}}
      <form method="POST" action="/login">
        <label>Email address<input type="email" name="email" placeholder="you@example.com" autocomplete="email" required></label>
        <label>Password<div class="password-wrap"><input type="password" name="password" autocomplete="current-password" required><span>◉</span></div></label>
        <button class="primary-btn" type="submit">Sign in</button>
      </form>
      <a class="login-create" href="/register">Create an account</a>
    </section>
  </main>
{{> footer }}